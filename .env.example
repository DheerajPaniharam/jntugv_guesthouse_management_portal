# ==============================================================================
# UNIVERSITY GUEST HOUSE MANAGEMENT PORTAL - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://guesthouse.jntugv.edu.in

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Full connection string format:
DATABASE_URL=postgresql://db_user:db_password@db_host:5432/uni_guest_portal

# Or individual connection parameters:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=uni_guest_portal
# DB_USER=postgres
# DB_PASSWORD=your_secure_password
# DB_SSL=false # Set to true for cloud-managed PostgreSQL (AWS RDS, Supabase, Neon, etc.)

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a strong 64-character secret (e.g. `openssl rand -hex 32`)
# This must be set in production; do not leave it as the sample placeholder.
JWT_SECRET=replace_with_a_secure_random_production_jwt_secret_key_64_chars

# Initial Root Admin Password (used only on first database seed if users table is empty)
# Set a unique strong value in production; never use the sample password in live deployments.
INITIAL_ADMIN_PASSWORD=change_me_to_a_strong_admin_password

# ------------------------------------------------------------------------------
# 4. INSTITUTIONAL EMAIL NOTIFICATIONS (SMTP)
# ------------------------------------------------------------------------------
# Required for live OTP verification, booking approvals, and password recovery
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=guesthouse.portal@jntugv.edu.in
EMAIL_PASS=your_app_specific_password_here
EMAIL_FROM=noreply@jntugv.edu.in

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (Razorpay / Instant Sandbox Mode)
# ------------------------------------------------------------------------------
# Set PAYMENT_MODE=live for production settlement, or sandbox for internal testing
PAYMENT_MODE=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 6. PLUGGABLE STORAGE DRIVER (Local Disk vs Cloud Object Storage)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
# For AWS S3 / Cloudflare R2 / MinIO:
# STORAGE_DRIVER=s3
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=jntugv-guesthouse-documents
# AWS_S3_ENDPOINT=
